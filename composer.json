{
  "name": "velay-precision/consentements",
  "description": "Formulaire de consentement declaratif pour Velay Precision",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.5",
    "ext-ctype": "*",
    "ext-iconv": "*",
    "ext-intl": "*",
    "ext-pdo_pgsql": "*",
    "symfony/flex": "^2.0",
    "symfony/runtime": "7.4.*",
    "symfony/framework-bundle": "7.4.*",
    "symfony/console": "7.4.*",
    "symfony/yaml": "7.4.*",
    "symfony/dotenv": "7.4.*",
    "symfony/twig-bundle": "7.4.*",
    "symfony/form": "7.4.*",
    "symfony/validator": "7.4.*",
    "symfony/security-bundle": "7.4.*",
    "symfony/security-csrf": "7.4.*",
    "symfony/rate-limiter": "7.4.*",
    "symfony/mailer": "7.4.*",
    "symfony/asset": "7.4.*",
    "symfony/ux-twig-component": "^2.28",
    "easycorp/easyadmin-bundle": "^5.0",
    "doctrine/orm": "^3.4",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/doctrine-migrations-bundle": "^3.4",
    "doctrine/dbal": "^4.4",
    "dompdf/dompdf": "^3.1"
  },
  "require-dev": {
    "symfony/phpunit-bridge": "7.4.*",
    "symfony/browser-kit": "7.4.*",
    "symfony/css-selector": "7.4.*"
  },
  "autoload": {"psr-4": {"App\\": "src/"}},
  "autoload-dev": {"psr-4": {"App\\Tests\\": "tests/"}},
  "config": {
    "sort-packages": true,
    "allow-plugins": {"symfony/flex": true, "symfony/runtime": true}
  },
  "extra": {"symfony": {"allow-contrib": false, "require": "7.4.*", "docker": false}},
  "scripts": {
    "auto-scripts": {"cache:clear": "symfony-cmd"},
    "post-install-cmd": ["@auto-scripts"],
    "post-update-cmd": ["@auto-scripts"]
  }
}
