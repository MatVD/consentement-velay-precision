{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Fiche client — {{ client.name }}{% endblock %}
{% block configured_stylesheets %}
  {{ parent() }}
  {% if is_granted('ROLE_OPERATOR') %}
    {# A dedicated versioned asset prevents browsers from reusing older panel styles. #}
    <link rel="stylesheet" href="{{ asset('assets/client-actions-drawer.css') }}?v=20261013-2">
  {% endif %}
{% endblock %}
{% block page_actions %}
  {% if is_granted('ROLE_OPERATOR') %}
    <button type="button" id="client-actions-trigger"
            class="btn btn-outline-secondary client-actions-trigger"
            data-client-actions-open aria-controls="client-actions-drawer"
            aria-haspopup="dialog" aria-label="Ouvrir les actions du client"
            title="Actions du client">
      <i class="fa fa-ellipsis" aria-hidden="true"></i>
    </button>
  {% endif %}
{% endblock %}
{# Display the one-time private link inside the client record before EasyAdmin consumes flash messages. #}
{% block flash_messages %}{% endblock %}
{% block main %}
  {% set decision_finale = client.status in ['yes', 'no'] or not client.active %}
  {% set onsite_links = app.flashes('onsite_link') %}

  <div class="mb-3">
    <a href="{{ path('admin_client_index') }}" class="btn btn-outline-secondary">
      <i class="fa fa-arrow-left" aria-hidden="true"></i> Retour aux clients
    </a>
  </div>

  {% for type, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }}" role="status">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {% if is_granted('ROLE_OPERATOR') %}
    {{ include('admin/_client_actions_drawer.html.twig', {
      client: client,
      decision_finale: decision_finale,
      onsite_links: onsite_links
    }, with_context = false) }}
  {% endif %}

  <p><strong>Statut :</strong> {{ client.statusLabel }} · <strong>Dossier :</strong> {{ client.active ? 'Actif' : 'Archivé' }} · <strong>Email :</strong> {{ client.email ?: 'Non renseigné' }}</p>
  {% if client.contractEndedAt %}
    <p><strong>Fin de relation :</strong> {{ client.contractEndedAt|date('d/m/Y', 'Europe/Paris') }} · <strong>Archivage :</strong> {{ client.archivedAt|date('d/m/Y', 'Europe/Paris') }}</p>
  {% endif %}
  <p><strong>Référence Codial :</strong> {{ client.codialId ?: '—' }}</p>

  <h2>Décisions enregistrées</h2>
  {% if decisions is empty %}
    <p>Aucune réponse pour ce client.</p>
  {% else %}
    <div class="responsive-data-table" role="region" aria-label="Décisions enregistrées" tabindex="0">
    <table class="table table-striped">
      <thead><tr><th>Date</th><th>Personne déclarée</th><th>Qualité</th><th>Décision</th><th>Justificatif</th></tr></thead>
      <tbody>
      {% for decision in decisions %}
        <tr>
          <td data-label="Date">{{ decision.decidedAt|date('d/m/Y H:i', 'Europe/Paris') }}</td>
          <td data-label="Personne">{{ decision.firstName }} {{ decision.lastName }}</td>
          <td data-label="Qualité">{{ decision.signatoryRole }}</td>
          <td data-label="Décision">{{ decision.choice == 'yes' ? 'Oui' : 'Non' }}</td>
          <td data-label="Justificatif">{% for proof in files %}{% if proof.decision.id == decision.id %}<a href="{{ path('admin_proof_download', {id: proof.id}) }}">Télécharger le PDF</a>{% endif %}{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  {% endif %}
  <h2 class="mt-4">Historique récent</h2>
  {% set event_labels = {
    'link_created': 'Lien créé',
    'email_sent': 'Invitation envoyée',
    'email_failed': 'Échec de l’envoi',
    'decision_recorded': 'Décision enregistrée',
    'evidence_downloaded': 'Justificatif téléchargé',
    'client_archived': 'Client archivé'
  } %}
  {% set actor_labels = {'admin': 'Collaborateur', 'client': 'Client', 'system': 'Système'} %}
  {% if events is empty %}<p>Pas d'événements.</p>{% else %}
    <div class="responsive-data-table" role="region" aria-label="Historique récent" tabindex="0">
      <table class="table table-striped">
        <thead><tr><th>Date</th><th>Événement</th><th>Origine</th></tr></thead>
        <tbody>
        {% for event in events %}
          <tr>
            <td data-label="Date">{{ event.createdAt|date('d/m/Y H:i', 'Europe/Paris') }}</td>
            <td data-label="Événement">{{ event_labels[event.type] ?? event.type }}</td>
            <td data-label="Origine">{{ actor_labels[event.actorType] ?? event.actorType }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
  <script src="{{ asset('assets/client-link-copy.js') }}" defer></script>
  {% if is_granted('ROLE_OPERATOR') %}
    <script src="{{ asset('assets/client-actions-drawer.js') }}?v=20261013-2" defer></script>
  {% endif %}
{% endblock %}
