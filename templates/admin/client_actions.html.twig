{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Fiche client — {{ client.name }}{% endblock %}
{# Display the one-time private link inside the client record before EasyAdmin consumes flash messages. #}
{% block flash_messages %}{% endblock %}
{% block main %}
  {% set decision_finale = client.status in ['yes', 'no'] or not client.active %}

  <div class="mb-3">
    <a href="{{ path('admin_client_index') }}" class="btn btn-outline-secondary">
      <i class="fa fa-arrow-left" aria-hidden="true"></i> Retour aux clients
    </a>
  </div>

  {% for link in app.flashes('onsite_link') %}
    <div class="alert alert-info mb-3 client-link-flash position-relative pe-5" role="status">
      <button type="button" class="btn-close position-absolute top-0 end-0 p-3"
              aria-label="Fermer le message de lien présentiel" title="Fermer"
              data-bs-dismiss="alert"></button>
      <strong>Lien individuel généré (valable 24 heures)</strong>
      <p class="mb-2">Copiez ce lien pour le transmettre ou le présenter au client :</p>
      <div class="input-group">
        <input id="client-onsite-link-{{ loop.index }}" type="text" class="form-control"
               value="{{ link }}" readonly aria-label="Lien individuel à copier" onfocus="this.select()">
        <button type="button" class="btn btn-outline-secondary" data-copy-link="client-onsite-link-{{ loop.index }}">
          <i class="fa fa-copy" aria-hidden="true"></i> Copier
        </button>
        <a href="{{ link }}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">Ouvrir</a>
      </div>
      <span id="client-onsite-link-{{ loop.index }}-status" class="visually-hidden" role="status" aria-live="polite"></span>
    </div>
  {% endfor %}
  {% for type, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ type == 'danger' ? 'danger' : (type == 'warning' ? 'warning' : 'success') }}" role="status">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  {% if is_granted('ROLE_OPERATOR') %}
  <section class="card mb-4" aria-labelledby="client-invitation-heading">
    <div class="card-body">
      <h2 id="client-invitation-heading" class="h5">Lien individuel pour le client</h2>
      <p class="text-muted mb-3">Générez un lien personnel valable 24 heures pour que le client renseigne son choix concernant la signature électronique.</p>
      <form method="post" action="{{ path('admin_client_onsite', {id: client.id}) }}">
        <input type="hidden" name="_token" value="{{ csrf_token('onsite_' ~ client.id) }}">
        <button type="submit" class="btn btn-primary" {% if decision_finale %}disabled{% endif %}>
          <i class="fa fa-link" aria-hidden="true"></i> Générer un lien
        </button>
      </form>
      {% if decision_finale %}
        <p class="text-muted mt-2 mb-0">Une décision définitive est déjà enregistrée : aucun nouveau lien ne peut être généré.</p>
      {% endif %}
    </div>
  </section>
  {% endif %}

  <p><strong>Statut :</strong> {{ client.statusLabel }} · <strong>Dossier :</strong> {{ client.active ? 'Actif' : 'Archivé' }} · <strong>Email :</strong> {{ client.email ?: 'Non renseigné' }}</p>
  {% if client.contractEndedAt %}
    <p><strong>Fin de relation :</strong> {{ client.contractEndedAt|date('d/m/Y', 'Europe/Paris') }} · <strong>Archivage :</strong> {{ client.archivedAt|date('d/m/Y', 'Europe/Paris') }}</p>
  {% endif %}
  <p><strong>Référence Codial :</strong> {{ client.codialId ?: '—' }}</p>

  {% if is_granted('ROLE_ADMIN') and client.active %}
    <section class="card mb-4" aria-labelledby="close-contract-heading">
      <div class="card-body">
        <h2 id="close-contract-heading" class="h5">Clôturer la relation contractuelle</h2>
        <p class="text-muted">Cette action fait passer le dossier dans l'archive normale.
          Aucun justificatif n'est supprimé à cette étape.</p>
        <form method="post" action="{{ path('admin_client_close_contract', {id: client.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('archive_' ~ client.id) }}">
          <div class="mb-3">
            <label class="form-label" for="contract-ended-{{ client.id }}">Date de fin de relation</label>
            <input id="contract-ended-{{ client.id }}" class="form-control" style="max-width: 240px"
                   type="date" name="ended_at" max="{{ 'now'|date('Y-m-d', 'Europe/Paris') }}" required>
          </div>
          <button type="submit" class="btn btn-outline-warning"
                  onclick="return confirm('Confirmer la clôture de la relation contractuelle et l’archivage du client ?');">
            Clôturer et archiver
          </button>
        </form>
      </div>
    </section>
  {% endif %}
  <h2>Décisions enregistrées</h2>
  {% if decisions is empty %}
    <p>Aucune réponse pour ce client.</p>
  {% else %}
    <div class="responsive-data-table" role="region" aria-label="Décisions enregistrées" tabindex="0">
    <table class="table table-striped">
      <thead><tr><th>Date</th><th>Personne déclarée</th><th>Qualité</th><th>Décision</th><th>Justificatif</th></tr></thead>
      <tbody>
      {% for decision in decisions %}
        <tr>
          <td data-label="Date">{{ decision.decidedAt|date('d/m/Y H:i', 'Europe/Paris') }}</td>
          <td data-label="Personne">{{ decision.firstName }} {{ decision.lastName }}</td>
          <td data-label="Qualité">{{ decision.signatoryRole }}</td>
          <td data-label="Décision">{{ decision.choice == 'yes' ? 'Oui' : 'Non' }}</td>
          <td data-label="Justificatif">{% for proof in files %}{% if proof.decision.id == decision.id %}<a href="{{ path('admin_proof_download', {id: proof.id}) }}">Télécharger le PDF</a>{% endif %}{% endfor %}</td>
        </tr>
      {% endfor %}
      </tbody>
    </table>
    </div>
  {% endif %}
  <h2 class="mt-4">Historique récent</h2>
  {% set event_labels = {
    'link_created': 'Lien créé',
    'email_sent': 'Invitation envoyée',
    'email_failed': 'Échec de l’envoi',
    'decision_recorded': 'Décision enregistrée',
    'evidence_downloaded': 'Justificatif téléchargé',
    'client_archived': 'Client archivé'
  } %}
  {% set actor_labels = {'admin': 'Collaborateur', 'client': 'Client', 'system': 'Système'} %}
  {% if events is empty %}<p>Pas d'événements.</p>{% else %}
    <div class="responsive-data-table" role="region" aria-label="Historique récent" tabindex="0">
      <table class="table table-striped">
        <thead><tr><th>Date</th><th>Événement</th><th>Origine</th></tr></thead>
        <tbody>
        {% for event in events %}
          <tr>
            <td data-label="Date">{{ event.createdAt|date('d/m/Y H:i', 'Europe/Paris') }}</td>
            <td data-label="Événement">{{ event_labels[event.type] ?? event.type }}</td>
            <td data-label="Origine">{{ actor_labels[event.actorType] ?? event.actorType }}</td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
  <script src="{{ asset('assets/client-link-copy.js') }}" defer></script>
{% endblock %}
