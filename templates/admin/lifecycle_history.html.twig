{% extends '@EasyAdmin/page/content.html.twig' %}
{% block content_title %}Historique du cycle de vie des clients{% endblock %}
{% block main %}
  <p>Chaque type de transition n'apparaît qu'une seule fois par mois, sans identité, date précise, numéro de dossier ou nombre de clients. Cet historique ne permet pas de retrouver les dossiers supprimés.</p>
  <div class="responsive-data-table" role="region" aria-label="Historique des archivages" tabindex="0">
    <table class="table table-striped">
      <thead><tr><th>Mois</th><th>Événement</th></tr></thead>
      <tbody>
        {% for event in events %}
          <tr>
            <td data-label="Mois">{{ event.createdAt|date('m/Y', 'UTC') }}</td>
            <td data-label="Événement">{{ event.label }}</td>
          </tr>
        {% else %}
          <tr><td colspan="2">Aucun événement pour le moment.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <p class="text-muted">Seuls les 100 événements les plus récents sont affichés.</p>
{% endblock %}
