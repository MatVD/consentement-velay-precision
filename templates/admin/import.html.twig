{% extends '@EasyAdmin/page/content.html.twig' %}
{# Render the structured import report ourselves, before EasyAdmin consumes flash messages. #}
{% block flash_messages %}{% endblock %}
{% block content_title %}Importer des clients (CSV){% endblock %}
{% block main %}
  {% for result in app.flashes('import_result') %}
    <section class="alert alert-info" role="status" aria-label="Résultat de l'import CSV">
      <strong>Import terminé</strong>
      <p class="mb-2">
        <strong>{{ result.added }}</strong> client(s) ajouté(s) ·
        <strong>{{ result.duplicates }}</strong> doublon(s) ignoré(s) ·
        <strong>{{ result.rejected }}</strong> ligne(s) rejetée(s).
      </p>
      {% if result.errors is not empty %}
        <details>
          <summary>Consulter les erreurs par ligne ({{ result.errors|length }} affichée(s))</summary>
          <ul class="mb-0 mt-2">
            {% for error in result.errors %}
              <li>Ligne {{ error.line }} : {{ error.reason }}</li>
            {% endfor %}
          </ul>
          {% if result.rejected > result.errors|length %}
            <p class="mb-0">Seules les {{ result.errors|length }} premières erreurs sont détaillées.</p>
          {% endif %}
        </details>
      {% endif %}
    </section>
  {% endfor %}

  {% for type, messages in app.flashes %}
    {% for message in messages %}
      <div class="alert alert-{{ type == 'danger' ? 'danger' : 'success' }}" role="alert">{{ message }}</div>
    {% endfor %}
  {% endfor %}

  <p>CSV <strong>UTF-8</strong>, séparateur <strong>point-virgule</strong>, taille maximale <strong>1 Mo</strong> et <strong>3 000 lignes</strong> de données par import.</p>
  <p>Colonne <code>Identité</code> ou <code>Entreprise</code> obligatoire. Colonnes facultatives : <code>Email</code>, <code>Référence Codial</code>, <code>Prénom représentant</code>, <code>Nom représentant</code>, <code>Fonction représentant</code>.</p>
  <p>Les doublons sont ignorés et <strong>aucun statut existant n'est modifié</strong>. Les lignes invalides sont signalées dans un compte rendu.</p>

  <pre class="csv-example" role="region" aria-label="Exemple de fichier CSV" tabindex="0">Identité;Email;Référence Codial;Prénom représentant;Nom représentant;Fonction représentant
Boulangerie Martin;contact@example.fr;COD123;Anne;Martin;Gérante
Restaurant du Centre;restaurant@example.fr;COD124;;;</pre>
  <form method="post" enctype="multipart/form-data" class="csv-import-form">
    <input type="hidden" name="_token" value="{{ csrf_token('import_clients') }}">
    <div class="mb-3">
      <label class="form-label" for="clients-csv">Choisir un fichier CSV</label>
      <input class="form-control" id="clients-csv" type="file" name="csv" accept=".csv,text/csv" required>
    </div>
    <button class="btn btn-primary" type="submit">Importer les clients</button>
  </form>
{% endblock %}
