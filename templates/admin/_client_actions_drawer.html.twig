{# Opened from the ellipsis in the customer heading. Keep permissions and CSRF server-side. #}
<dialog id="client-actions-drawer" class="client-actions-drawer"
        aria-labelledby="client-actions-title"
        data-client-actions-drawer
        {% if onsite_links is not empty %}data-client-actions-auto-open{% endif %}>
  <div class="client-actions-drawer__header">
    <div>
      <h2 class="client-actions-drawer__title" id="client-actions-title">Actions du client</h2>
      <p class="client-actions-drawer__subtitle">{{ client.name }}</p>
    </div>
    <button type="button" class="btn-close client-actions-drawer__close"
            data-client-actions-close aria-label="Fermer le panneau" title="Fermer"></button>
  </div>
  <div class="client-actions-drawer__body">
    {% for link in onsite_links %}
      <div class="alert alert-info client-link-flash position-relative pe-5" role="status">
        <button type="button" class="btn-close position-absolute top-0 end-0 p-3"
                aria-label="Fermer le message de lien présentiel" title="Masquer le lien"
                data-bs-dismiss="alert"></button>
        <strong>Lien individuel généré (valable 24 heures)</strong>
        <p class="mb-2">Copiez ce lien pour le transmettre ou le présenter au client :</p>
        <div class="input-group">
          <input id="client-onsite-link-{{ loop.index }}" type="text" class="form-control"
                 value="{{ link }}" readonly aria-label="Lien individuel à copier" onfocus="this.select()">
          <button type="button" class="btn btn-outline-secondary" data-copy-link="client-onsite-link-{{ loop.index }}">
            <i class="fa fa-copy" aria-hidden="true"></i> Copier
          </button>
          <a href="{{ link }}" class="btn btn-outline-primary" target="_blank" rel="noopener noreferrer">Ouvrir</a>
        </div>
        <span id="client-onsite-link-{{ loop.index }}-status" class="visually-hidden" role="status" aria-live="polite"></span>
      </div>
    {% endfor %}

    <section class="card client-actions-drawer__card" aria-labelledby="client-invitation-heading">
      <div class="card-body">
        <h3 id="client-invitation-heading" class="h5">Lien individuel pour le client</h3>
        <p class="text-muted mb-3">Générez un lien personnel valable 24 heures pour que le client renseigne son choix concernant la signature électronique.</p>
        <form method="post" action="{{ path('admin_client_onsite', {id: client.id}) }}">
          <input type="hidden" name="_token" value="{{ csrf_token('onsite_' ~ client.id) }}">
          <button type="submit" class="btn btn-primary" {% if decision_finale %}disabled{% endif %}>
            <i class="fa fa-link" aria-hidden="true"></i> Générer un lien
          </button>
        </form>
        {% if decision_finale %}
          <p class="text-muted mt-2 mb-0">{{ client.active ? 'Une décision définitive est déjà enregistrée : aucun nouveau lien ne peut être généré.' : 'Le dossier est archivé : aucun lien ne peut être généré.' }}</p>
        {% endif %}
      </div>
    </section>

    {% if is_granted('ROLE_ADMIN') and client.active %}
      <section class="card client-actions-drawer__card" aria-labelledby="close-contract-heading">
        <div class="card-body">
          <h3 id="close-contract-heading" class="h5">Clôturer la relation contractuelle</h3>
          <p class="text-muted">Cette action fait passer le dossier dans l'archive normale. Aucun justificatif n'est supprimé à cette étape.</p>
          <form method="post" action="{{ path('admin_client_close_contract', {id: client.id}) }}">
            <input type="hidden" name="_token" value="{{ csrf_token('archive_' ~ client.id) }}">
            <div class="mb-3">
              <label class="form-label" for="contract-ended-{{ client.id }}">Date de fin de relation</label>
              <input id="contract-ended-{{ client.id }}" class="form-control"
                     type="date" name="ended_at" max="{{ 'now'|date('Y-m-d', 'Europe/Paris') }}" required>
            </div>
            <button type="submit" class="btn btn-outline-warning"
                    onclick="return confirm('Confirmer la clôture de la relation contractuelle et l’archivage du client ?');">
              Clôturer et archiver
            </button>
          </form>
        </div>
      </section>
    {% endif %}
  </div>
</dialog>
